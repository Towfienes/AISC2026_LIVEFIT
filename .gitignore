# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
# venv riêng chỉ có python-docx, dùng để dựng hồ sơ dự thi
.venv-docx/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Environment / secrets — NEVER commit credentials
.env
*.pem
*.key
secrets/

# Data — raw data never enters git (PII policy: only scrubbed data in DB, none in repo)
data/raw/
data/sessions/
# Ảnh chụp kho memory: bản sao đầy đủ của dữ liệu phiên thật (đã lọc PII nhưng
# vẫn là dữ liệu người dùng) — không bao giờ vào git.
data/snapshot/
*.dump
*.sql.gz
# Lô gán nhãn: bình luận THẬT (đã lọc PII) của phiên quan sát — vẫn là dữ liệu
# người dùng, không vào git. Chỉ README mô tả lô được commit.
data/labeling/*
!data/labeling/README.md

# Node / Next.js
web/node_modules/
web/.next/
web/out/

# Notebooks: strip outputs before commit (see HARNESS.md); checkpoints never committed
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# DB backups — operational artifacts, never in git
backups/

# scratch working files
audit_findings.txt
research_specs.txt

# Thông tin cá nhân của đội thi (ngày sinh, MSSV, SĐT) — không bao giờ commit.
# Tạo từ docs/competition/thong-tin-doi.example.json.
docs/competition/thong-tin-doi.local.json

# Bo thu chay nen: danh sach bo thu dang bat (tu noi lai sau khoi dong lai)
data/ingest-jobs.json
data/ingest-jobs.tmp

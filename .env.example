# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
POSTGRES_USER=livelift
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=livelift
# Local dev outside Docker:
DATABASE_URL=postgresql://livelift:change-me-strong-password@127.0.0.1:5432/livelift
REDIS_URL=redis://127.0.0.1:6379/0

# --- Cổng vào công khai (Caddy) ---
# Tên miền thật (vd: livelift.example.com) → Caddy tự xin chứng chỉ HTTPS
# (cần DNS trỏ về máy chủ và mở cổng 80/443). Để trống → chạy dev tại
# http://localhost, không TLS. Người xem bấm shortlink qua địa chỉ này:
# http(s)://<DOMAIN>/r/{code} — nguyên tắc 4 của runbook.
DOMAIN=

# --- App ---
LIVELIFT_ENV=dev            # dev | prod
# URL API mà TRÌNH DUYỆT gọi — đi qua Caddy với tiền tố /api.
# Có tên miền thật: đổi thành https://<DOMAIN>/api. Biến NEXT_PUBLIC_* được
# nhúng vào bundle LÚC BUILD — đổi xong phải chạy: docker compose build web
NEXT_PUBLIC_API_URL=http://localhost/api
# URL CÔNG KHAI hiển thị cho link đo /r/{code} (dán vào bình luận ghim).
# Có tên miền thật: đặt https://<DOMAIN>. Để trống → rơi về NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_PUBLIC_API_BASE=

# Token bảo vệ endpoint ghi (POST comments/ticks). Để trống = tắt (dev/demo).
# Khi đặt, runner ingest tự đính header Authorization: Bearer <token>.
INGEST_TOKEN=

# Tiền đăng ký §7 (chặn peeking): ngày ISO YYYY-MM-DD (theo UTC). Khi đặt và
# ngày hiện tại CHƯA tới ngày này, /experiment/summary khóa mọi trường suy diễn
# (tác động ước lượng, p-value, khoảng tin cậy) — chỉ trả số liệu vận hành
# (số phiên, số khối, CV, MDE). Để trống = tắt (dev/demo). Giá trị sai định
# dạng sẽ KHÓA luôn cho tới khi sửa (fail-closed).
RESULTS_FREEZE_UNTIL=

# --- Platform APIs (leave empty until credentials exist) ---
YOUTUBE_API_KEY=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v23.0

# Phân tích VOD YouTube: nếu gặp lỗi "YouTube yêu cầu xác minh không phải bot",
# đặt tên trình duyệt bạn đã đăng nhập YouTube (chrome | edge | firefox).
# Cookie chỉ được đọc cục bộ bởi yt-dlp, không gửi đi đâu ngoài YouTube.
YTDLP_COOKIES_FROM_BROWSER=

# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
POSTGRES_USER=livelift
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=livelift
# Local dev outside Docker:
DATABASE_URL=postgresql://livelift:change-me-strong-password@127.0.0.1:5432/livelift
REDIS_URL=redis://127.0.0.1:6379/0

# --- CHỌN KHO LƯU TRỮ — biến quan trọng nhất trong tệp này ---------------
# memory   = mọi thứ nằm trong RAM. NHANH, không cần Docker, và MẤT SẠCH khi
#            tiến trình khởi động lại. Ngày 11/09/2026 đúng điều này đã xảy ra:
#            13 phiên live thật + 17.535 bình luận biến mất lúc 13:05:53, không
#            khôi phục được. Chỉ dùng cho thử nhanh.
# postgres = dữ liệu nằm trong cơ sở dữ liệu, khởi động lại không mất gì.
#            BẮT BUỘC cho mọi phiên live thật.
#
# CHÚ Ý cái bẫy đã dính một lần (sự cố 25/08/2026): đặt DATABASE_URL ở trên là
# CHƯA ĐỦ. DATABASE_URL chỉ nói cơ sở dữ liệu ở ĐÂU; biến dưới đây mới quyết
# định có dùng nó hay không. Thiếu nó thì API vẫn chạy vui vẻ trên RAM.
# Bật nhanh cả đường Postgres:  python scripts/bat_postgres.py
STORE_BACKEND=memory

# --- Lưới an toàn cho chế độ memory (ảnh chụp định kỳ) -------------------
# Chỉ có tác dụng khi STORE_BACKEND=memory. Định kỳ ghi TOÀN BỘ trạng thái ra
# một tệp JSON (ghi nguyên tử: tệp tạm rồi đổi tên) và tự nạp lại khi khởi
# động. Mất tối đa bằng đúng chu kỳ dưới đây, thay vì mất cả phiên.
# KHÔNG phải thứ thay thế Postgres cho phiên live thật.
# Kiểm tra đang ở chế độ nào: curl -s http://127.0.0.1:8000/health
STORE_SNAPSHOT_ENABLED=true
STORE_SNAPSHOT_PATH=data/snapshot/livelift-store.json
STORE_SNAPSHOT_INTERVAL_S=30

# --- Hạn giờ khi cơ sở dữ liệu chết (sự cố 13/09/2026) ------------------
# Hôm đó PostgreSQL chết hẳn giữa lúc chạy: mỗi lần GET /sessions treo ĐÚNG 30
# GIÂY (mặc định của psycopg_pool) rồi trả "Internal Server Error" trần, còn
# /health vẫn báo xanh vì nó chưa bao giờ hỏi cơ sở dữ liệu lấy một câu.
# Bốn hạn giờ dưới đây là bốn PHA khác nhau, không thay nhau được:
#   CONNECT   — bắt tay với máy chủ (libpq mặc định: chờ VÔ HẠN);
#   POOL      — chờ pool cấp một kết nối (mặc định 30,0 = con số đã đếm được).
#               Để NGẮN HƠN hạn 2,5 giây của trang web, nếu không thì câu 503
#               tiếng Việt trả về sau khi trình duyệt đã bỏ cuộc;
#   STATEMENT — chờ máy chủ chạy xong truy vấn (khóa bảng, máy chủ lết);
#   PING      — lần hỏi thăm của /health, phải ngắn hơn hẳn hạn của route.
# Cơ sở dữ liệu ở xa (mạng chậm) thì nới POOL/STATEMENT, đừng bỏ hẳn.
# libpq làm tròn CONNECT < 2 lên 2 giây.
STORE_CONNECT_TIMEOUT_S=3
STORE_POOL_TIMEOUT_S=2.0
STORE_STATEMENT_TIMEOUT_S=8.0
HEALTH_PING_TIMEOUT_S=1.5
# Kết quả ping được nhớ ngần này giây để trang web hỏi /health liên tục mà
# không đấm vào cơ sở dữ liệu. Đặt 0 để ping thật ở mọi lần gọi.
HEALTH_PING_CACHE_S=5.0

# --- Cổng vào công khai (Caddy) ---
# Tên miền thật (vd: livelift.example.com) → Caddy tự xin chứng chỉ HTTPS
# (cần DNS trỏ về máy chủ và mở cổng 80/443). Để trống → chạy dev tại
# http://localhost, không TLS. Người xem bấm shortlink qua địa chỉ này:
# http(s)://<DOMAIN>/r/{code} — nguyên tắc 4 của runbook.
DOMAIN=

# --- App ---
LIVELIFT_ENV=dev            # dev | prod
# URL API mà TRÌNH DUYỆT gọi — đi qua Caddy với tiền tố /api.
# Có tên miền thật: đổi thành https://<DOMAIN>/api. Biến NEXT_PUBLIC_* được
# nhúng vào bundle LÚC BUILD — đổi xong phải chạy: docker compose build web
NEXT_PUBLIC_API_URL=http://localhost/api
# URL CÔNG KHAI hiển thị cho link đo /r/{code} (dán vào bình luận ghim).
# Có tên miền thật: đặt https://<DOMAIN>. Để trống → rơi về NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_PUBLIC_API_BASE=

# Danh sách GỐC (origin) mà TRÌNH DUYỆT được phép gọi API, ngăn cách bằng dấu
# phẩy. Đọc ở src/livelift/api/main.py.
#   Để TRỐNG / không đặt → mặc định http://localhost:3000,http://127.0.0.1:3000
#   (đúng cho máy mình, SAI cho máy chủ công khai).
# Khi đã có tên miền thật, PHẢI đặt thành chính tên miền đó, ví dụ:
#   CORS_ORIGINS=https://livelift.example.com
# Lưu ý: dựng bằng docker compose thì trình duyệt và API đi CHUNG một gốc qua
# Caddy (/api), nên CORS gần như không được dùng tới — biến này dành cho lúc
# tách web và API ra hai tên miền khác nhau. Đặt đúng vẫn hơn để mặc định:
# mặc định localhost trên máy chủ thật là một cấu hình sai đang nằm im.
CORS_ORIGINS=

# --- XÁC THỰC ĐƯỜNG GHI — bắt buộc trước khi mở địa chỉ công khai ---------
# Một token duy nhất bảo vệ CẢ 15 endpoint ghi (POST). Trước 14/09/2026 nó chỉ
# che 3 đường nạp của bộ thu, 12 đường còn lại mở toang: người lạ biết URL là
# KẾT THÚC ĐƯỢC một phiên thí nghiệm đang chạy. Nay dependency require_write_auth
# gắn ở cấp ứng dụng nên route ghi nào cũng đi qua cổng.
#
#   Để TRỐNG = TẮT KIỂM TRA HOÀN TOÀN. Đúng cho máy mình và cho bộ kiểm thử;
#   SAI, và nguy hiểm, cho một máy chủ có địa chỉ công khai.
#   Sinh token:  openssl rand -base64 32     (hoặc: python -c "import secrets;print(secrets.token_urlsafe(32))")
#
# Khi đặt, runner ingest và scripts/spool_replay tự đính header
# Authorization: Bearer <token>.
INGEST_TOKEN=

# Chế độ TRƯNG BÀY công khai — chỉ có tác dụng khi INGEST_TOKEN đã đặt.
# Câu hỏi nó trả lời: một người KHÔNG có token (giám khảo, khách xem thử) còn
# làm được gì?
#   true  (mặc định) — khách tạo được phiên của riêng mình và chạy trọn wizard
#                      (lịch gán → phát → ghim → kết thúc) trên phiên đó. Máy
#                      chủ ghi phiên ấy là is_demo=true nên nó KHÔNG BAO GIỜ
#                      lọt vào kết quả khoa học thật. Khách KHÔNG chạm được
#                      vào phiên thật, KHÔNG bơm được bình luận/lượt xem, và
#                      KHÔNG gọi được /replays/youtube.
#   false            — khoá sạch: mọi đường ghi đòi token. Đặt false cho máy
#                      chủ đang chạy thí nghiệm THẬT và không cần cho người lạ
#                      bấm thử.
PUBLIC_DEMO_WRITES=true

# Trần tần suất cho đường ghi MỞ (chống một người làm ngập buổi demo). Chỉ áp
# cho yêu cầu KHÔNG có token — bộ thu của đội bắn một bình luận mỗi giây và
# không bao giờ bị chặn. Đặt 0 để tắt.
# Đếm theo địa chỉ người gọi, lấy phần tử CUỐI của X-Forwarded-For (phần Caddy
# nối thêm) nên không tự bịa được bằng một dòng curl.
WRITE_RATE_LIMIT_PER_MIN=30
# /demo/seed và /demo/seed-vang sinh hàng nghìn bản ghi mỗi lần gọi nên có
# trần riêng, tính theo giờ.
DEMO_SEED_RATE_LIMIT_PER_HOUR=6

# Tiền đăng ký §7 (chặn peeking): ngày ISO YYYY-MM-DD (theo UTC). Khi đặt và
# ngày hiện tại CHƯA tới ngày này, /experiment/summary khóa mọi trường suy diễn
# (tác động ước lượng, p-value, khoảng tin cậy) — chỉ trả số liệu vận hành
# (số phiên, số khối, CV, MDE). Để trống = tắt (dev/demo). Giá trị sai định
# dạng sẽ KHÓA luôn cho tới khi sửa (fail-closed).
RESULTS_FREEZE_UNTIL=

# --- Platform APIs (leave empty until credentials exist) ---
YOUTUBE_API_KEY=
# Đường đọc live YouTube: api | ytdlp  (mặc định api)
#   api   = YouTube Data API, cần YOUTUBE_API_KEY ở trên. ĐÂY LÀ ĐƯỜNG CHUẨN,
#           dùng cho phiên thí nghiệm chính thức (độ trễ 2-5s, hợp Điều khoản).
#   ytdlp = đọc chat công khai bằng yt-dlp, KHÔNG cần key — chạy được ngay hôm
#           nay, nhưng độ trễ ~24s và CÁCH TRUY CẬP NÀY TRÁI Điều khoản dịch vụ
#           của YouTube (robots.txt chặn /live_chat, /youtubei/). Chỉ dùng cho
#           phiên của chính nhóm / kiểm thử / dự phòng khi mất key, và phải khai
#           báo nếu dữ liệu vào bài báo.
#           Chi tiết: docs/research/2026-09-09-youtube-ytdlp-live.md
INGEST_YOUTUBE_BACKEND=api
# Facebook: xem hướng dẫn từng bước ở docs/huong-dan-facebook-token.md,
# rồi kiểm tra bằng: python scripts/kiem_tra_facebook.py
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v25.0
# CHỈ dùng cho script kiểm tra token (đọc /debug_token để biết hạn + quyền).
# KHÔNG cần cho ingest — đừng đưa app secret lên máy chạy ingest/VPS.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Shopee Live — API CHÍNH THỨC (Shopee Open Platform v2), hợp Điều khoản dịch vụ.
# Đây là nền tảng DUY NHẤT khảo sát được (11/09/2026) vừa cho bình luận vừa cho
# tín hiệu chuyển đổi (gmv / orders / atc) qua một API chính thức, và tài liệu
# endpoint ghi rõ có Việt Nam. Chỉ đọc được phiên của shop ĐÃ ủy quyền cho app.
#   partner_id/partner_key : tài khoản open.shopee.com của nhóm
#   user_id/access_token   : kết quả luồng ủy quyền OAuth của CHÍNH người phát
#   access_token sống 4 GIỜ — phải làm mới bằng refresh_token giữa phiên dài.
# API livestream là loại "User": ký và gửi bằng user_id, KHÔNG phải shop_id
# (tài liệu gốc open.shopee.com, sửa 17/09/2026).
# Hướng dẫn + bảng khả năng từng nền tảng: docs/nen-tang-ho-tro.md
# Kiểm tra: python scripts/kiem_tra_shopee.py --session-id <SESSION_ID>
# BẮT BUỘC để thu bình luận/người xem/chỉ số: PARTNER_ID, PARTNER_KEY, USER_ID, ACCESS_TOKEN.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Mã tài khoản người phát (dãy số) — lấy từ user_id_list trong phản hồi
# v2.public.get_access_token sau khi ủy quyền. Không phải mã shop.
SHOPEE_USER_ID=
# Mã shop (dãy số) — CHỈ cần cho ghim sản phẩm qua API (update_show_item).
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
# global (gồm Việt Nam — Shopee KHÔNG có host .vn) | china | brazil | sandbox
SHOPEE_REGION=global

# Phân tích VOD YouTube: nếu gặp lỗi "YouTube yêu cầu xác minh không phải bot",
# đặt tên trình duyệt bạn đã đăng nhập YouTube (chrome | edge | firefox).
# Cookie chỉ được đọc cục bộ bởi yt-dlp, không gửi đi đâu ngoài YouTube.
YTDLP_COOKIES_FROM_BROWSER=

# --- Bộ thực thi tự động cho phiên mode=auto (sự cố 12/09) --------------------
# Trước 12/09 chế độ "auto" chỉ là cái nhãn: không tiến trình nào gọi
# /actions/execute, nên phiên chạy hết với tuân thủ = 0 mà không một cảnh báo.
# Nay máy chủ tự ghim ở khối BẬT, đi qua ĐÚNG đường execute_action.
# 0 | false | no | off  = TẮT (khi đó phải ghim tay, nếu không thí nghiệm rỗng).
# LƯU Ý: vòng quét nằm trong tiến trình API — chạy MỘT worker, hoặc đặt
# LIVELIFT_AUTOPILOT=0 ở mọi worker trừ một, để hai tiến trình không đua nhau.
LIVELIFT_AUTOPILOT=1
# Giây giữa hai vòng quét.
LIVELIFT_AUTOPILOT_TICK_S=5
# Sau bao nhiêu PHÚT một phiên auto đang phát mà vẫn 0 hành động thì
# GET /sessions/{id}/state báo động (báo động tính từ kho, nên vẫn kêu cả khi
# bộ thực thi bị tắt).
LIVELIFT_AUTOPILOT_SILENCE_MIN=5

# next.js
/.next/
# Thư mục build của MỌI tiến trình dev/build song song (LIVELIFT_DIST_DIR trong
# next.config.mjs). Sự cố 13/09/2026: nhiều tiến trình cùng ghi một `.next` làm
# hỏng thư mục build và trang chủ hiện HTML thô không CSS. Luật từ đó: mỗi tiến

# Cấu hình web LiveLift — sao chép thành .env.local rồi điền giá trị thật.
# Chỉ các biến NEXT_PUBLIC_* được nhúng vào trình duyệt (Next.js inline lúc build).

# URL máy chủ FastAPI mà TRÌNH DUYỆT VẬN HÀNH gọi (REST + WebSocket /ws/{session_id}).
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL CÔNG KHAI của máy chủ đo lượt nhấp — dùng để hiển thị link /r/{code}
# dán vào bình luận ghim. Người xem phải mở được địa chỉ này từ NGOÀI mạng
# của bạn (domain thật hoặc tunnel như cloudflared/ngrok). Để trống thì giao
# diện rơi về NEXT_PUBLIC_API_BASE, rồi NEXT_PUBLIC_API_URL (localhost — chỉ
# đủ cho demo trên cùng một máy).
NEXT_PUBLIC_PUBLIC_API_BASE=

# Đặt =1 để chạy toàn bộ giao diện với dữ liệu mô phỏng, không cần máy chủ.
NEXT_PUBLIC_MOCK=
